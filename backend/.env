# backend/.env

# --- DB ---
DB_USER=dev_user
DB_PASSWORD=dev_password
DB_HOST=db_citas
DB_PORT=5432
DB_NAME=citas_online_db

# --- Flask / JWT ---
SECRET_KEY=una_clave_secreta_segura
JWT_SECRET_KEY=otra_clave_jwt_segura      # <- única fuente para JWT
# JWT_SECRET (ELIMINADO): era duplicado / no se usa
JWT_ACCESS_TOKEN_EXPIRES=3600        # 1h (en segundos)
JWT_REFRESH_TOKEN_EXPIRES=1209600    # 14d (en segundos)

# --- Mailhog ---
MAIL_SERVER=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=False
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=notificaciones@citasonline.com

# --- Magic Links / Teléfonos ---
MAGIC_LINK_TTL_DAYS=7
MAGIC_LINK_ONE_TIME=false
MAGIC_LINK_BASE_URL=http://localhost:5173/magic
DEFAULT_PHONE_REGION=ES

# --- App ---
FLASK_DEBUG=1
PORT=5001
# POST_LOGIN_REDIRECT=/                 # opcional, si lo usas más adelante

# --- WhatsApp Cloud API ---
WHATSAPP_SEND_ENABLED=true
WHATSAPP_VERIFY_TOKEN=mi_token_webhook_seguro
WHATSAPP_ACCESS_TOKEN=EAAUxZBCKOjcUBPHqspi5MWK1ABEjVCywuTJ24uHRsZCUbltQcD1yAXNhv0R06y4bhLDEMGVW9xIhLnJzZB1YsgrmNcpZB3rFElDSRWSWUYngfBMqEWHU8pgaZAeJDhZBHGsKDM71o79521opLZCzyr9v5LCIzepKmEaJhiWvZBcNLsRzBHWAWitszCOziWR27Lifxb8FAKFuA76LVYijLeDZCLndmtWFZCWOrcATERM7WVMK6U1wZDZD
WHATSAPP_PHONE_NUMBER_ID=710558738814354
BOOKING_KEYWORDS=RESERVAR,RESERVA,CITA
WHATSAPP_DEFAULT_NEXT=/                 # next por defecto si no llega en la invite
FRONTEND_BASE_URL=http://localhost:5173
