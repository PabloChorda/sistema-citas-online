# TTL por defecto de invitaciones creadas por el webhook (usado en whatsapp.py)
WHATSAPP_INVITE_TTL_MINUTES=60

# Modo dev: el webhook devuelve la URL de invitación en la respuesta (útil para probar)
ECHO_WEBHOOK_INVITE_URL=false
# (ECHO_WEBHOOK_MAGIC_URL DEPRECADO/ELIMINADO)

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
OTP_DEBUG_RETURN_CODE=true

# Purga de OTPs
OTP_PURGE_KEEP_HOURS=24
# 0 = deshabilitado (sin hilo de purga en background)
OTP_PURGE_INTERVAL_MIN=0

LIMITER_STORAGE_URI=redis://redis:6379/0

