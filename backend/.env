# backend/.env

# --- DB ---
DB_USER=dev_user
DB_PASSWORD=dev_password
DB_HOST=db_citas
DB_PORT=5432
DB_NAME=citas_online_db

# --- Flask / App entrypoint ---
FLASK_APP=wsgi:app
FLASK_DEBUG=1
PORT=5001

# --- JWT / Secrets ---
SECRET_KEY=una_clave_secreta_secreta
JWT_SECRET_KEY=otra_clave_jwt_segura
JWT_ACCESS_TOKEN_EXPIRES=3600        # 1h
JWT_REFRESH_TOKEN_EXPIRES=1209600    # 14d

# --- Mailhog ---
MAIL_SERVER=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=False
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=notificaciones@citasonline.com

# --- Magic Links / Teléfonos ---
MAGIC_LINK_TTL_DAYS=7
MAGIC_LINK_ONE_TIME=false
DEFAULT_PHONE_REGION=ES

# ¡OJO! Ajustado a 5174 (tu Vite actual)
FRONTEND_BASE_URL=http://localhost:5174
MAGIC_LINK_BASE_URL=http://localhost:5174/magic

# --- Rate limiting (Redis) ---
# Usa el hostname del servicio en docker-compose:
# Si tu servicio se llama "redis" deja esta:
LIMITER_STORAGE_URI=redis://redis:6379/0
# Si tu servicio se llama "redis_rate", usa esta en su lugar:
# LIMITER_STORAGE_URI=redis://redis_rate:6379/0

# --- WhatsApp Cloud API ---
WHATSAPP_SEND_ENABLED=true
WHATSAPP_VERIFY_TOKEN=mi_token_webhook_seguro
WHATSAPP_ACCESS_TOKEN=EAAUxZBCKOjcUBPHqspi5MWK1ABEjVCywuTJ24uHRsZCUbltQcD1yAXNhv0R06y4bhLDEMGVW9xIhLnJzZB1YsgrmNcpZB3rFElDSRWSWUYngfBMqEWHU8pgaZAeJDhZBHGsKDM71o79521opLZCzyr9v5LCIzepKmEaJhiWvZBcNLsRzBHWAWitszCOziWR27Lifxb8FAKFuA76LVYijLeDZCLndmtWFZCWOrcATERM7WVMK6U1wZDZD
