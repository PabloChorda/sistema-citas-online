# backend/.env

# --- DB ---
DB_USER=dev_user
DB_PASSWORD=dev_password
DB_HOST=db_citas
DB_PORT=5432
DB_NAME=citas_online_db

# --- Flask / App entrypoint ---
FLASK_APP=wsgi:app
FLASK_DEBUG=1
PORT=5001

# --- JWT / Secrets ---
SECRET_KEY=una_clave_secreta_secreta
JWT_SECRET_KEY=otra_clave_jwt_segura
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=1209600

# --- Mailhog ---
MAIL_SERVER=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=False
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=notificaciones@citasonline.com

# --- Magic Links / Teléfonos ---
MAGIC_LINK_TTL_DAYS=7
MAGIC_LINK_ONE_TIME=false
MAGIC_LINK_BASE_URL=http://localhost:5175/magic
DEFAULT_PHONE_REGION=ES

# --- Rate limiting ---
LIMITER_STORAGE_URI=redis://redis:6379/0

