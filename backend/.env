OTP_PURGE_KEEP_HOURS=24
OTP_PURGE_INTERVAL_MIN=0

# --- Demo Mode ---
DEMO_MODE=1
DEMO_READONLY=1
DEMO_SECRET=
DEMO_WRITE_ALLOWLIST=^/api/(auth/(login|refresh|token)|appointments($|/.*))
APP_VERSION=demo-1

# --- CORS ---
# Acepta puertos típicos de Vite (5173/5174/5175) y deja preparado para Netlify
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:5175
CORS_ALLOWED_ORIGENS=http://localhost:5174,http://localhost:5173,http://localhost:5175

