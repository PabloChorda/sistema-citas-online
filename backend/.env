# .env

# --- DB ---
DB_USER=dev_user
DB_PASSWORD=dev_password
DB_HOST=db_citas
DB_PORT=5432
DB_NAME=citas_online_db

# --- Flask / JWT ---
SECRET_KEY=una_clave_secreta_segura
JWT_SECRET_KEY=otra_clave_jwt_segura
JWT_SECRET=otra_clave_jwt_segura  # mantener igual que JWT_SECRET_KEY por ahora

# --- Mailhog ---
MAIL_SERVER=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=False
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=notificaciones@citasonline.com

# --- Magic Links / WhatsApp ---
MAGIC_LINK_TTL_DAYS=7              # caducidad (días)
MAGIC_LINK_ONE_TIME=true           # true = un solo uso
MAGIC_LINK_BASE_URL=http://localhost:5173/magic
DEFAULT_PHONE_REGION=ES            # para normalizar teléfonos (E.164)

# --- App ---
FLASK_DEBUG=1
PORT=5001
# POST_LOGIN_REDIRECT=/            # (opcional) si luego quieras redirigir desde backend
