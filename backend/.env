# backend/.env

# --- DB ---
DB_USER=dev_user
DB_PASSWORD=dev_password
DB_HOST=db_citas
DB_PORT=5432
DB_NAME=citas_online_db

# --- Flask / App entrypoint ---
# Usado por `flask ...` dentro del contenedor (compose)
FLASK_APP=wsgi:app
FLASK_DEBUG=1

# Si ejecutas `python run.py` localmente, este puerto se usará ahí.
# En Docker no afecta porque en docker-compose ya pasas --port=5000
PORT=5001

# --- JWT / Secrets ---
SECRET_KEY=una_clave_secreta_secreta
JWT_SECRET_KEY=otra_clave_jwt_segura
JWT_ACCESS_TOKEN_EXPIRES=3600        # 1h (segundos)
JWT_REFRESH_TOKEN_EXPIRES=1209600    # 14d (segundos)

# --- Mailhog ---
MAIL_SERVER=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=False
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=notificaciones@citasonline.com

# --- Magic Links / Teléfonos ---
MAGIC_LINK_TTL_DAYS=7
MAGIC_LINK_ONE_TIME=false
MAGIC_LINK_BASE_URL=http://localhost:5173/magic
DEFAULT_PHONE_REGION=ES

# --- Rate limiting (Redis dentro de la red de compose) ---
LIMITER_STORAGE_URI=redis://redis:6379/0

# --- WhatsApp Cloud API ---
WHATSAPP_SEND_ENABLED=true
WHATSAPP_VERIFY_TOKEN=mi_token_webhook_seguro
WHATSAPP_ACCESS_TOKEN=EAAUxZBCKOjcUBPHqspi5MWK1ABEjVCywuTJ24uHRsZCUbltQcD1yAXNhv0R06y4bhLDEMGVW9xIhLnJzZB1YsgrmNcpZB3rFElDSRWSWUYngfBMqEWHU8pgaZAeJDhZBHGsKDM71o79521opLZCzyr9v5LCIzepKmEaJhiWvZBcNLsRzBHWAWitszCOziWR27Lifxb8FAKFuA76LVYijLeDZCLndmtWFZCWOrcATERM7WVMK6U1wZDZD
WHATSAPP_PHONE_NUMBER_ID=710558738814354
BOOKING_KEYWORDS=RESERVAR,RESERVA,CITA
WHATSAPP_DEFAULT_NEXT=/
FRONTEND_BASE_URL=http://localhost:5173
LOGIN_PHONE_PATH=/login-phone

# TTL por defecto de invitaciones creadas por el webhook (usado en whatsapp.py)
WHATSAPP_INVITE_TTL_MINUTES=60

# Modo dev: el webhook devuelve la URL de invitación en la respuesta (útil para probar)
ECHO_WEBHOOK_INVITE_URL=false

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
OTP_DEBUG_RETURN_CODE=true

# Purga de OTPs
OTP_PURGE_KEEP_HOURS=24
# 0 = deshabilitado (sin hilo de purga en background)
OTP_PURGE_INTERVAL_MIN=0

# --- Webhook signature ---
WHATSAPP_APP_SECRET=0c5a3bdd17c9553929149471126df328
WHATSAPP_REQUIRE_VALID_SIGNATURE=true

CRON_SECRET=supersecret-cron-key

# --- Demo Mode & CORS ---
DEMO_MODE=false
DEMO_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173
