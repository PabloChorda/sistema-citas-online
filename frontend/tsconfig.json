{
    "compilerOptions": {
      "target": "ES2021",
      "module": "ESNext",
      "jsx": "react-jsx",
      "moduleResolution": "Bundler",
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "isolatedModules": true,
      "allowJs": true,
      "noEmit": true
    },
    "include": ["src"]
  }